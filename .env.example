# Google Analytics 4 measurement ID. Leave blank to disable GA4.
PUBLIC_GA4_ID=
PUBLIC_TABOOLA_ID=
PUBLIC_META_PIXEL_ID=
PUBLIC_LEAD_FUNNEL_ENABLED=false
# Render the contact form only after CONTACT_ENDPOINT is configured.
PUBLIC_CONTACT_FORM_ENABLED=false
# Server-only URL that receives mapped partner lead JSON.
LEAD_ENDPOINT=
# Server-only marker value required by the partner lead API.
PARTNER_MARKER=
# Server-only offer value required by the partner lead API.
PARTNER_OFFER=
# Server-only URL that receives validated contact-message JSON.
CONTACT_ENDPOINT=
# Server-only base URL for Taboola S2S conversion postbacks.
TABOOLA_S2S_ENDPOINT=
# Server-only Taboola Realize Event Name.
TABOOLA_EVENT_NAME=
# Server-only token required to open the internal funnel report.
FUNNEL_REPORT_TOKEN=
