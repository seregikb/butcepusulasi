---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageIntro from '@/components/PageIntro.astro';
import ContactDetails from '@/components/ContactDetails.astro';
import HoneypotField from '@/components/HoneypotField.astro';

const contactFormEnabled = import.meta.env.PUBLIC_CONTACT_FORM_ENABLED === 'true';
---

<BaseLayout title="İletişim" description="Bütçe Pusulası editör ekibine içerik soruları, düzeltme bildirimleri ve genel görüşleriniz için ulaşın.">
  <PageIntro title="İletişim" description="İçeriklerle ilgili görüş, düzeltme bildirimi veya genel sorularınız için bize yazabilirsiniz." />
  <section class:list={['container grid gap-12 py-12 md:py-16', contactFormEnabled && 'md:grid-cols-[1fr_1.4fr]']}>
    <div>
      <h2 class="text-2xl font-bold">İletişim bilgileri</h2>
      <ContactDetails class="mt-4 text-muted" />
      <p class="mt-5 leading-7 text-muted">Kişiye özel finansal danışmanlık veya ürün başvurusu hizmeti vermediğimizi hatırlatırız.</p>
    </div>
    {contactFormEnabled && <form id="contact-form" class="space-y-5" action="/api/contact" method="post" novalidate>
      <div>
        <label class="mb-2 block font-bold" for="name">Adınız</label>
        <input class="min-h-12 w-full border border-rule bg-white px-4" id="name" name="name" type="text" autocomplete="name" required maxlength="100" />
      </div>
      <div>
        <label class="mb-2 block font-bold" for="email">E-posta adresiniz</label>
        <input class="min-h-12 w-full border border-rule bg-white px-4" id="email" name="email" type="email" autocomplete="email" required maxlength="160" />
      </div>
      <div>
        <label class="mb-2 block font-bold" for="message">Mesajınız</label>
        <textarea class="min-h-40 w-full border border-rule bg-white p-4" id="message" name="message" required maxlength="3000"></textarea>
      </div>
      <HoneypotField />
      <button class="min-h-12 border border-accent bg-accent px-6 font-bold text-white disabled:cursor-not-allowed disabled:opacity-60" type="submit">Mesajı gönder</button>
      <p id="form-status" class="min-h-6 text-sm font-semibold" role="status" aria-live="polite"></p>
    </form>}
  </section>
</BaseLayout>

{contactFormEnabled && <script is:inline>
  const form = document.querySelector('#contact-form');
  const status = document.querySelector('#form-status');
  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!(form instanceof HTMLFormElement) || !(status instanceof HTMLElement)) return;
    if (!form.reportValidity()) return;
    const data = new FormData(form);
    if (String(data.get('website') || '')) {
      form.reset();
      status.textContent = 'Mesajınız gönderildi. Teşekkür ederiz.';
      return;
    }
    const button = form.querySelector('button[type="submit"]');
    if (button instanceof HTMLButtonElement) button.disabled = true;
    status.textContent = 'Mesaj gönderiliyor…';
    try {
      const response = await fetch('/api/contact', {
        method: 'POST',
        body: data,
      });
      if (!response.ok) throw new Error('request_failed');
      form.reset();
      status.textContent = 'Mesajınız gönderildi. Teşekkür ederiz.';
    } catch {
      status.textContent = 'Mesaj gönderilemedi. Lütfen daha sonra tekrar deneyin veya e-posta gönderin.';
    } finally {
      if (button instanceof HTMLButtonElement) button.disabled = false;
    }
  });
</script>}
