---
import type { GetStaticPaths } from 'astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import ArticleCard from '@/components/ArticleCard.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import CoverArt from '@/components/CoverArt.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { CATEGORIES, SITE } from '@/lib/site';

export const getStaticPaths = (async () => {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, posts } }));
}) satisfies GetStaticPaths;

const { post, posts } = Astro.props;
const { Content } = await render(post);
const related = post.data.relatedPosts
  .map((id: string) => posts.find((entry: typeof post) => entry.id === id))
  .filter((entry: CollectionEntry<'blog'> | undefined): entry is CollectionEntry<'blog'> => Boolean(entry));
const date = post.data.pubDate.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long', year: 'numeric' });
const canonical = `${SITE.url}/blog/${post.id}/`;
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate || post.data.pubDate).toISOString(),
  author: { '@type': 'Organization', name: post.data.author },
  publisher: { '@type': 'Organization', name: SITE.name, logo: { '@type': 'ImageObject', url: `${SITE.url}/favicon.svg` } },
  image: `${SITE.url}/og/${post.id}.png`,
  mainEntityOfPage: canonical,
  inLanguage: 'tr-TR',
};
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Ana Sayfa', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'Yazılar', item: `${SITE.url}/blog/` },
    { '@type': 'ListItem', position: 3, name: post.data.title, item: canonical },
  ],
};
const faqSchema = post.data.faq ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: post.data.faq.map((item: { q: string; a: string }) => ({
    '@type': 'Question', name: item.q, acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
} : null;
---

<BaseLayout title={post.data.title} shortTitle={post.data.shortTitle} description={post.data.description} image={`/og/${post.id}.png`} type="article" schema={[articleSchema, breadcrumbSchema, ...(faqSchema ? [faqSchema] : [])]}>
  <article class="container py-10 md:py-14">
    <div class="mx-auto max-w-[820px]">
      <Breadcrumbs items={[{ label: 'Ana Sayfa', href: '/' }, { label: 'Yazılar', href: '/blog/' }, { label: post.data.title }]} />
      <p class="text-sm font-bold text-accent">{CATEGORIES[post.data.category].name}</p>
      <h1 class="mt-3 text-4xl font-bold leading-tight md:text-6xl">{post.data.title}</h1>
      <p class="mt-5 text-xl leading-8 text-muted">{post.data.description}</p>
      <div class="mt-6 flex flex-wrap gap-x-4 gap-y-2 text-sm text-muted">
        <span>{post.data.author}</span><span aria-hidden="true">·</span>
        <time datetime={post.data.pubDate.toISOString()}>{date}</time><span aria-hidden="true">·</span>
        <span>{post.data.readingTime} dakika okuma</span>
      </div>
      <div class="mt-9"><CoverArt slug={post.id} alt={post.data.heroImageAlt} eager /></div>
    </div>
    <div class="prose mx-auto mt-10">
      <Content />
    </div>
  </article>

  {related.length > 0 && (
    <section class="container border-t border-rule py-14">
      <h2 class="text-3xl font-bold">İlgili yazılar</h2>
      <div class="mt-8 grid gap-10 md:grid-cols-2">
        {related.map((entry) => <ArticleCard post={entry} />)}
      </div>
    </section>
  )}
</BaseLayout>
