---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Sayfa bulunamadı" description="Aradığınız sayfa bulunamadı. Bütçe Pusulası ana sayfasına dönerek içerikleri inceleyebilirsiniz." noindex>
  <section class="container py-24 text-center">
    <p class="font-bold text-accent">404</p>
    <h1 class="mt-3 text-4xl font-bold md:text-6xl">Bu sayfa bulunamadı</h1>
    <p class="mx-auto mt-5 max-w-xl text-lg leading-8 text-muted">Bağlantı değişmiş veya sayfa kaldırılmış olabilir.</p>
    <a class="mt-8 inline-flex min-h-11 items-center border border-accent px-5 font-bold text-accent" href="/">Ana sayfaya dön</a>
  </section>
</BaseLayout>
