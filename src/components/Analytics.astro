---
import { GATED_ROUTE_SET } from '@/data/gated-routes';

const ga4Id = import.meta.env.PUBLIC_GA4_ID;
const taboolaId = import.meta.env.PUBLIC_TABOOLA_ID;
const metaId = import.meta.env.PUBLIC_META_PIXEL_ID;
const funnelEnabled = import.meta.env.PUBLIC_LEAD_FUNNEL_ENABLED === 'true';
const pathname = Astro.url.pathname;
const taboolaEvent = GATED_ROUTE_SET.has(pathname)
  ? funnelEnabled && pathname === '/butce-plani/'
    ? 'step_1'
    : funnelEnabled && pathname === '/tesekkurler/'
      ? 'lead'
      : undefined
  : 'page_view';
const renderTaboola = Boolean(taboolaId && taboolaEvent);
---

<div id="analytics-config" hidden data-ga4={ga4Id || undefined} data-meta={metaId || undefined}></div>

<script is:inline>
  (() => {
    let loaded = false;
    function loadAnalytics() {
      if (loaded || localStorage.getItem('butce-pusulasi-cookie-consent') !== 'accepted') return;
      loaded = true;
      const config = document.querySelector('#analytics-config');
      const ga4 = config?.getAttribute('data-ga4');
      const meta = config?.getAttribute('data-meta');

      if (ga4) {
        const script = document.createElement('script');
        script.async = true;
        script.src = `https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(ga4)}`;
        document.head.append(script);
        window.dataLayer = window.dataLayer || [];
        window.gtag = function () { window.dataLayer.push(arguments); };
        window.gtag('js', new Date());
        window.gtag('config', ga4);
      }
      if (meta) {
        window.fbq = window.fbq || function () { window.fbq.callMethod ? window.fbq.callMethod.apply(window.fbq, arguments) : window.fbq.queue.push(arguments); };
        window.fbq.queue = [];
        window.fbq.loaded = true;
        window.fbq.version = '2.0';
        window.fbq('init', meta);
        window.fbq('track', 'PageView');
        const script = document.createElement('script');
        script.async = true;
        script.src = 'https://connect.facebook.net/en_US/fbevents.js';
        document.head.append(script);
      }
      const eventName = document.body.dataset.conversionEvent;
      if (eventName) {
        if (window.gtag) window.gtag('event', eventName);
        if (window.fbq) window.fbq('trackCustom', eventName);
      }
    }
    loadAnalytics();
    window.addEventListener('cookie-consent', loadAnalytics);
  })();
</script>

{renderTaboola && (
  <Fragment>
    <div id="taboola-config" hidden data-taboola={taboolaId} data-event={taboolaEvent}></div>
    <script is:inline>
      (() => {
        let loaded = false;
        function loadTaboola() {
          if (loaded || localStorage.getItem('butce-pusulasi-cookie-consent') !== 'accepted') return;
          const config = document.querySelector('#taboola-config');
          const id = config?.getAttribute('data-taboola');
          const eventName = config?.getAttribute('data-event');
          if (!id || !eventName) return;
          loaded = true;
          window._tfa = window._tfa || [];
          window._tfa.push({ notify: 'event', name: eventName, id });
          if (document.getElementById('tb_tfa_script')) return;
          const script = document.createElement('script');
          script.async = true;
          script.src = '//cdn.taboola.com/libtrc/unip/' + encodeURIComponent(id) + '/tfa.js';
          script.id = 'tb_tfa_script';
          document.head.append(script);
        }
        loadTaboola();
        window.addEventListener('cookie-consent', loadTaboola);
      })();
    </script>
  </Fragment>
)}
