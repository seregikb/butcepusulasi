<div id="cookie-banner" class="pointer-events-none invisible fixed inset-x-0 bottom-0 z-[80] flex border-t border-rule" role="dialog" aria-label="Çerez tercihleri" aria-live="polite" aria-hidden="true">
  <div class="mx-auto grid w-full max-w-5xl grid-cols-[minmax(0,1fr)_auto] items-start gap-2 px-3 pt-1">
    <p class="pointer-events-auto m-0 bg-paper text-xs leading-4 text-muted">
      Analiz ve reklam çerezleri için izninizi istiyoruz.
      <a class="font-semibold text-accent underline" href="/cerez-politikasi/">Çerez Politikası</a>
    </p>
    <div class="pointer-events-auto grid grid-cols-2 gap-1">
      <button data-cookie-choice="rejected" type="button" class="h-11 border border-accent bg-paper px-0 text-xs font-bold text-accent">Reddet</button>
      <button data-cookie-choice="accepted" type="button" class="h-11 border border-accent bg-paper px-0 text-xs font-bold text-accent">Kabul Et</button>
    </div>
  </div>
</div>

<script is:inline>
  (() => {
    const key = 'butce-pusulasi-cookie-consent';
    const banner = document.querySelector('#cookie-banner');
    const choice = localStorage.getItem(key);
    if (!choice) {
      banner?.classList.remove('invisible');
      banner?.setAttribute('aria-hidden', 'false');
    } else {
      banner?.classList.add('hidden');
    }
    document.querySelectorAll('[data-cookie-choice]').forEach((button) => {
      button.addEventListener('click', () => {
        const value = button.getAttribute('data-cookie-choice');
        if (!value) return;
        localStorage.setItem(key, value);
        banner?.classList.add('hidden');
        banner?.setAttribute('aria-hidden', 'true');
        document.documentElement.classList.remove('cookie-consent-pending');
        window.dispatchEvent(new CustomEvent('cookie-consent', { detail: value }));
      });
    });
  })();
</script>
