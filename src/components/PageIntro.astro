---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
}

const { eyebrow, title, description } = Astro.props;
---

<header class="container border-b border-rule py-12 md:py-16">
  {eyebrow && <p class="mb-3 text-sm font-bold text-accent">{eyebrow}</p>}
  <h1 class="max-w-4xl text-4xl font-bold leading-tight md:text-6xl">{title}</h1>
  {description && <p class="mt-5 max-w-2xl text-lg leading-8 text-muted md:text-xl">{description}</p>}
</header>
