---
import { SITE } from '@/lib/site';
---

<a href="#main-content" class="fixed left-4 top-3 z-[100] -translate-y-20 bg-ink px-4 py-3 text-sm font-bold text-white focus:translate-y-0">
  İçeriğe geç
</a>
<header class="sticky top-0 z-50 border-b border-rule bg-paper/95 backdrop-blur-sm">
  <div class="container flex min-h-16 items-center justify-between gap-5">
    <a href="/" class="text-xl font-bold text-accent no-underline" aria-label={`${SITE.name} ana sayfa`}>
      {SITE.name}
    </a>
    <button id="nav-toggle" class="grid size-11 place-items-center md:hidden" type="button" aria-controls="site-nav" aria-expanded="false">
      <span class="sr-only">Menüyü aç</span>
      <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M4 7h16M4 12h16M4 17h16"></path>
      </svg>
    </button>
    <nav id="site-nav" class="absolute inset-x-0 top-16 hidden border-b border-rule bg-paper px-4 py-4 md:static md:block md:border-0 md:p-0" aria-label="Ana menü">
      <ul class="m-0 flex list-none flex-col gap-1 p-0 md:flex-row md:items-center md:gap-6">
        <li><a class="flex min-h-11 items-center text-base font-semibold hover:text-accent" href="/blog/">Yazılar</a></li>
        <li><a class="flex min-h-11 items-center text-base font-semibold hover:text-accent" href="/kategori/butceleme/">Bütçeleme</a></li>
        <li><a class="flex min-h-11 items-center text-base font-semibold hover:text-accent" href="/kategori/tasarruf/">Tasarruf</a></li>
        <li><a class="flex min-h-11 items-center text-base font-semibold hover:text-accent" href="/hakkimizda/">Hakkımızda</a></li>
      </ul>
    </nav>
  </div>
</header>

<script is:inline>
  const navButton = document.querySelector('#nav-toggle');
  const nav = document.querySelector('#site-nav');
  navButton?.addEventListener('click', () => {
    const expanded = navButton.getAttribute('aria-expanded') === 'true';
    navButton.setAttribute('aria-expanded', String(!expanded));
    nav?.classList.toggle('hidden', expanded);
  });
</script>
