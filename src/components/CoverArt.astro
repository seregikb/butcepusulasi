---
interface Props {
  slug: string;
  alt?: string;
  eager?: boolean;
}

const { slug, alt = '', eager = false } = Astro.props;
const imageBase = `/images/articles/${slug}`;
---

<picture class="cover-art block overflow-hidden bg-surface">
  <source
    type="image/webp"
    srcset={`${imageBase}-720.webp 720w, ${imageBase}.webp 1440w`}
    sizes="(min-width: 1024px) 820px, (min-width: 768px) 50vw, 100vw"
  />
  <img
    src={`${imageBase}.webp`}
    width="1440"
    height="810"
    alt={alt}
    class="h-full w-full object-cover"
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : 'auto'}
    decoding="async"
  />
</picture>

<style>
  .cover-art {
    aspect-ratio: 16 / 9;
  }
</style>
