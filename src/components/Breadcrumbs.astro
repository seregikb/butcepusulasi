---
interface Item {
  label: string;
  href?: string;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
---

<nav aria-label="İçerik yolu" class="mb-7 text-sm text-muted">
  <ol class="m-0 flex list-none flex-wrap items-center gap-2 p-0">
    {items.map((item, index) => (
      <li class="flex items-center gap-2">
        {item.href ? <a class="hover:text-accent hover:underline" href={item.href}>{item.label}</a> : <span aria-current="page">{item.label}</span>}
        {index < items.length - 1 && <span aria-hidden="true">/</span>}
      </li>
    ))}
  </ol>
</nav>
