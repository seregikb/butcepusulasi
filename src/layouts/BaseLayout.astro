---
import Analytics from '@/components/Analytics.astro';
import CookieBanner from '@/components/CookieBanner.astro';
import Footer from '@/components/Footer.astro';
import Header from '@/components/Header.astro';
import { SITE } from '@/lib/site';
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = SITE.name,
  description = SITE.description,
  image = '/og/default.png',
  type = 'website',
  noindex = false,
  schema = [],
} = Astro.props;
const titleCandidate = title === SITE.name ? title : `${title} | ${SITE.name}`;
const pageTitle = titleCandidate.length <= 60 ? titleCandidate : `${title.slice(0, 57).trimEnd()}…`;
const canonical = new URL(Astro.url.pathname, SITE.url);
const imageUrl = new URL(image, SITE.url);
const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.name,
  url: SITE.url,
  logo: `${SITE.url}/favicon.svg`,
};
const schemas = [organization, ...(Array.isArray(schema) ? schema : [schema])];
const funnelEnabled = import.meta.env.PUBLIC_LEAD_FUNNEL_ENABLED === 'true';
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} RSS`} href="/rss.xml" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:site_name" content={SITE.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <title>{pageTitle}</title>
    {schemas.map((entry) => <script is:inline type="application/ld+json" set:html={JSON.stringify(entry)} />)}
  </head>
  <body>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <CookieBanner />
    <Analytics />
    {funnelEnabled && (
      <script is:inline>
        const clickId = new URLSearchParams(location.search).get('tblci');
        if (clickId) sessionStorage.setItem('tblci', clickId);
      </script>
    )}
  </body>
</html>
